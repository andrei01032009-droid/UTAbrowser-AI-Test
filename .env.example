# ===== UTA Browser =====
# Скопируй этот файл в .env и заполни значения.

# Порт, на котором работает сервер
PORT=3000

# --- Вход через Google (OAuth 2.0) ---
# Получить ключи: https://console.cloud.google.com
# 1) Создай проект
# 2) "APIs & Services" -> "OAuth consent screen" -> External -> добавь себя в тестовых пользователей
# 3) "Credentials" -> "Create credentials" -> "OAuth client ID" -> тип "Web application"
# 4) В "Authorized redirect URIs" укажи: http://localhost:3000/auth/google/callback
#
# Если ключи не заполнены, включается демо-режим входа.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Полный URL, куда Google вернёт пользователя (не обязательно, если используешь localhost)
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
